<?xml version="1.0" encoding="utf-8"?>
<!--
  Vision room for kit_cam. Includes the frozen walk plant and does not
  edit it. Furniture is named scene geometry so a later vision step can
  point at "bathroom". This is not a navigation map, not a planner input,
  and not a mechanism. One camera: the plant's kit_cam.
  Vanity and mirror are CC0 Poly Haven meshes. The sink and toilet are
  CC0 textured meshes. Static bodies. See docs/ROOM_ASSETS.md.
-->
<mujoco model="room_bathroom">
  <include file="ainex_hiwonder/ainex_controls_m2_145.xml"/>
  <asset>
    <texture name="room_floor" type="2d" file="assets/rooms/textures/marble.png"/>
    <material name="room_floor" texture="room_floor" texrepeat="3 3" specular="0.12"/>
    <texture name="room_wall" type="2d" file="assets/rooms/textures/interior_tiles.png"/>
    <material name="room_wall" texture="room_wall" texrepeat="2 1.2" specular="0.06"/>
    <texture name="room_tile" type="2d" file="assets/rooms/textures/interior_tiles.png"/>
    <material name="room_tile" texture="room_tile" texrepeat="3 2" specular="0.08"/>
    <texture name="room_vanity" type="2d" file="assets/rooms/bathroom/vanity.png"/>
    <material name="room_vanity" texture="room_vanity" specular="0.16"/>
    <mesh name="room_vanity" file="assets/rooms/bathroom/vanity.obj"/>
    <texture name="room_mirror" type="2d" file="assets/rooms/bathroom/mirror.png"/>
    <material name="room_mirror" texture="room_mirror" specular="0.45"/>
    <mesh name="room_mirror" file="assets/rooms/bathroom/mirror.obj"/>
    <texture name="room_sink" type="2d" file="assets/rooms/bathroom/sink.png"/>
    <material name="room_sink" texture="room_sink" specular="0.2"/>
    <mesh name="room_sink" file="assets/rooms/bathroom/sink.obj"/>
    <texture name="room_bowl" type="2d" file="assets/rooms/bathroom/toilet_bowl.png"/>
    <material name="room_bowl" texture="room_bowl" specular="0.4"/>
    <mesh name="room_bowl" file="assets/rooms/bathroom/toilet_bowl.obj"/>
    <texture name="room_tank" type="2d" file="assets/rooms/bathroom/toilet_tank.png"/>
    <material name="room_tank" texture="room_tank" specular="0.25"/>
    <mesh name="room_tank" file="assets/rooms/bathroom/toilet_tank.obj"/>
    <texture name="room_seat" type="2d" file="assets/rooms/bathroom/toilet_seat.png"/>
    <material name="room_seat" texture="room_seat" specular="0.3"/>
    <mesh name="room_seat" file="assets/rooms/bathroom/toilet_seat.obj"/>
    <texture name="room_handle" type="2d" file="assets/rooms/bathroom/toilet_handle.png"/>
    <material name="room_handle" texture="room_handle" specular="0.5"/>
    <mesh name="room_handle" file="assets/rooms/bathroom/toilet_handle.obj"/>
  </asset>
  <worldbody>
    <light name="room_key" pos="0.15 -0.3 2.3" dir="0.6 0.05 -1" diffuse="0.82 0.82 0.80"/>
    <light name="room_fill" pos="0.1 1.0 1.7" dir="0.45 -0.35 -1" diffuse="0.34 0.38 0.42"/>
    <geom name="room_floor" type="plane" pos="0 0 0.006" size="3 3 0.02" material="room_floor" contype="0" conaffinity="0"/>
    <geom name="room_wall" type="box" pos="2.45 0 1.2" size="0.04 2.2 1.2" material="room_wall" contype="0" conaffinity="0"/>
    <!-- Vanity faces the robot (+X is kit_cam look). Static bodies, no joints. -->
    <body name="bathroom" pos="1.55 0.25 0">
      <site name="bathroom" pos="0.1 0 1.25" size="0.015" group="4" rgba="0.75 0.78 0.80 1"/>
      <geom name="bathroom_tile" type="box" pos="0.48 0 1.15" size="0.02 1.2 1.15" material="room_tile" contype="0" conaffinity="0"/>
      <geom name="bathroom_vanity" type="mesh" mesh="room_vanity" material="room_vanity" quat="0.707107 0 0 0.707107" contype="0" conaffinity="0"/>
      <geom name="bathroom_mirror" type="mesh" mesh="room_mirror" material="room_mirror" pos="0.42 0 1.30" quat="0.707107 0 0 0.707107" contype="0" conaffinity="0"/>
    </body>
    <body name="sink" pos="1.00 0.05 0.31">
      <site name="sink" pos="0 0 0.16" size="0.012" group="4" rgba="0.70 0.72 0.74 1"/>
      <geom name="sink_basin" type="mesh" mesh="room_sink" material="room_sink" quat="0 1 0 0" contype="0" conaffinity="0"/>
    </body>
    <body name="toilet" pos="1.22 -0.95 0">
      <site name="toilet" pos="0 0 0.42" size="0.012" group="4" rgba="0.85 0.86 0.88 1"/>
      <geom name="toilet_bowl" type="mesh" mesh="room_bowl" material="room_bowl" quat="0.707107 0 0 0.707107" contype="0" conaffinity="0"/>
      <geom name="toilet_tank" type="mesh" mesh="room_tank" material="room_tank" quat="0.707107 0 0 0.707107" contype="0" conaffinity="0"/>
      <geom name="toilet_seat" type="mesh" mesh="room_seat" material="room_seat" quat="0.707107 0 0 0.707107" contype="0" conaffinity="0"/>
      <geom name="toilet_handle" type="mesh" mesh="room_handle" material="room_handle" quat="0.707107 0 0 0.707107" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
