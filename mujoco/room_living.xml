<?xml version="1.0" encoding="utf-8"?>
<!--
  Vision room for kit_cam. Includes the frozen walk plant and does not
  edit it. Furniture is named scene geometry so a later vision step can
  point at "living". This is not a navigation map, not a planner input,
  and not a door. One camera: the plant's kit_cam.
  The living body is a rust sofa. The tv is a separate static prop.
-->
<mujoco model="room_living">
  <include file="ainex_hiwonder/ainex_controls_m2_145.xml"/>
  <worldbody>
    <!-- Sofa back faces the robot (+X is kit_cam look). Static bodies, no joints. -->
    <body name="living" pos="1.30 0.00 0">
      <site name="living" pos="-0.24 0 0.55" size="0.015" group="4" rgba="0.82 0.26 0.05 1"/>
      <geom name="living_sofa_seat" type="box" size="0.30 0.58 0.11" pos="0.06 0 0.30" rgba="0.84 0.30 0.06 1" friction="1.0 0.1 0.01" contype="1" conaffinity="1" condim="3"/>
      <geom name="living_sofa_back" type="box" size="0.09 0.58 0.24" pos="-0.24 0 0.52" rgba="0.72 0.20 0.04 1" friction="1.0 0.1 0.01" contype="1" conaffinity="1" condim="3"/>
      <geom name="living_sofa_arm_l" type="box" size="0.28 0.07 0.14" pos="0.04 0.58 0.42" rgba="0.62 0.16 0.03 1" friction="1.0 0.1 0.01" contype="1" conaffinity="1" condim="3"/>
      <geom name="living_sofa_arm_r" type="box" size="0.28 0.07 0.14" pos="0.04 -0.58 0.42" rgba="0.62 0.16 0.03 1" friction="1.0 0.1 0.01" contype="1" conaffinity="1" condim="3"/>
    </body>
    <body name="tv" pos="1.18 -1.15 0">
      <site name="tv" pos="-0.02 0 0.82" size="0.012" group="4" rgba="0.42 0.78 0.96 1"/>
      <geom name="tv_stand" type="box" size="0.14 0.32 0.24" pos="0 0 0.24" rgba="0.14 0.14 0.16 1" friction="1.0 0.1 0.01" contype="1" conaffinity="1" condim="3"/>
      <geom name="tv_bezel" type="box" size="0.025 0.40 0.24" pos="0 0 0.78" rgba="0.05 0.05 0.07 1" friction="1.0 0.1 0.01" contype="1" conaffinity="1" condim="3"/>
      <geom name="tv_screen" type="box" size="0.012 0.34 0.18" pos="-0.02 0 0.78" rgba="0.42 0.78 0.96 1" friction="1.0 0.1 0.01" contype="1" conaffinity="1" condim="3"/>
    </body>
  </worldbody>
</mujoco>
