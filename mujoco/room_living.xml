<?xml version="1.0" encoding="utf-8"?>
<!--
  Vision room for kit_cam. Includes the frozen walk plant and does not
  edit it. Furniture is named scene geometry so a later vision step can
  point at "living". This is not a navigation map, not a planner input,
  and not a mechanism. One camera: the plant's kit_cam.
  The living body is a sofa. The tv is a separate static prop.
  Meshes are CC0 textured models (see docs/ROOM_ASSETS.md).
-->
<mujoco model="room_living">
  <include file="ainex_hiwonder/ainex_controls_m2_145.xml"/>
  <asset>
    <texture name="room_floor" type="2d" file="assets/rooms/textures/wood_floor.png"/>
    <material name="room_floor" texture="room_floor" texrepeat="3 3" specular="0.04"/>
    <texture name="room_wall" type="2d" file="assets/rooms/textures/beige_wall.png"/>
    <material name="room_wall" texture="room_wall" texrepeat="2.2 1.3" specular="0.02"/>
    <texture name="room_sofa" type="2d" file="assets/rooms/living/sofa.png"/>
    <material name="room_sofa" texture="room_sofa" specular="0.22"/>
    <mesh name="room_sofa" file="assets/rooms/living/sofa.obj"/>
    <texture name="room_tv" type="2d" file="assets/rooms/living/tv.png"/>
    <material name="room_tv" texture="room_tv" specular="0.3"/>
    <mesh name="room_tv" file="assets/rooms/living/tv.obj"/>
  </asset>
  <worldbody>
    <light name="room_key" pos="0.2 -0.4 2.2" dir="0.6 0.1 -1" diffuse="0.78 0.74 0.66"/>
    <light name="room_fill" pos="0.2 1.15 1.6" dir="0.4 -0.45 -1" diffuse="0.32 0.36 0.42"/>
    <geom name="room_floor" type="plane" pos="0 0 0.006" size="3 3 0.02" material="room_floor" contype="0" conaffinity="0"/>
    <geom name="room_wall" type="box" pos="2.55 0 1.25" size="0.04 2.4 1.25" material="room_wall" contype="0" conaffinity="0"/>
    <!-- Sofa faces the robot (+X is kit_cam look). Static bodies, no joints. -->
    <body name="living" pos="1.62 0 0">
      <site name="living" pos="-0.15 0 0.55" size="0.015" group="4" rgba="0.55 0.32 0.18 1"/>
      <geom name="living_sofa_back" type="mesh" mesh="room_sofa" material="room_sofa" quat="0.707107 0 0 0.707107" contype="0" conaffinity="0"/>
    </body>
    <body name="tv" pos="0.95 -0.72 0">
      <site name="tv" pos="0 0 0.35" size="0.012" group="4" rgba="0.25 0.35 0.45 1"/>
      <geom name="tv_screen" type="mesh" mesh="room_tv" material="room_tv" quat="0.707107 0 0 0.707107" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
