<?xml version="1.0" encoding="utf-8"?>
<!--
  Test scene for Moondream2 / find_room entrance. Prefer FAIL.
  Includes the frozen walk plant and does not edit it. One camera: kit_cam.
  A narrow hall ends at a static front leaf in a wood casing. The robot
  stands in the hall looking along +X, so the low camera sees the leaf,
  the runner, and the side walls. This is not room_entrance (that scene
  is a square room with the castle panel, a mat, boots, and a console).
  Visual geometry only. No hinge, no lever, no latch, no knob torque.
  Not a navigation map, not a planner input, not an arrival, and not a
  go-anywhere claim. See docs/KIT_CAM_HALLWAY_FRONT.md and docs/ROOM_ASSETS.md.
-->
<mujoco model="room_hallway_front">
