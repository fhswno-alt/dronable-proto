      <geom name="kitchen_kettle" type="box" size="0.055 0.055 0.07" pos="0.10 0.38 0.96" rgba="0.85 0.12 0.14 1" friction="1.0 0.1 0.01" contype="1" conaffinity="1" condim="3"/>
