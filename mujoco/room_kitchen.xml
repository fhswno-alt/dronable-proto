    <material name="room_stool" texture="room_stool" specular="0.25"/>
    <mesh name="room_stool" file="assets/rooms/kitchen/stool.obj" scale="1.05 1.05 1.05"/>
    <texture name="room_pendant" type="2d" file="assets/rooms/kitchen/pendant.png"/>
