            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            custom int mujoco:condim = 3
            custom double mujoco:frictionRolling = 0.01
            custom double mujoco:frictionSliding = 1.6
            custom double mujoco:frictionTorsional = 0.1
            custom string mujoco:note = "condim 3 uses only the sliding coefficient 1.6. Torsional 0.1 and rolling 0.01 are stored and not enabled."
            float physics:dynamicFriction = 1.6
            float physics:staticFriction = 1.6
        }
    }

