        f"cam_distance={CAM_FIXED_DISTANCE}\n"
        f"cam_azimuth={CAM_FIXED_AZIMUTH}\n"
        f"cam_elevation={CAM_FIXED_ELEVATION}\n"
        f"ffmpeg_all_intra={ffmpeg_used}\n"
        f"n_frame_seq_pngs={len(frame_paths)}\n"
        f"assert_ok={assert_ok}\n"
        f"failures={';'.join(failures)}\n"
        f"n_video_frames={len(frame_paths)}\n"
        f"csv={csv_path}\n"
        f"mp4={args.out}\n"
        f"frame_seq={FRAME_SEQ}\n"
        f"version=v8\n"
        f"root_cause=v7_retracted_lookat_tracked_side_cam_cancelled_translation_"
        f"so_real_alternating_gait_looked_like_locked_split_statue_sliding_~1m;"
        f"color_centroid_31_flips_and_robot_ROI_MAD~35_were_reflection_flicker_"
        f"HUD_crop_MAD~2.4_matched_statue_band;"
        f"v8_fix=WORLD_FIXED_side_cam_corridor+assert_q_hip_knee_ankle_and_"
        f"thigh_shin_xmat_pitch_opposite_phase_ge4_cycles+silhouette_foot_bbox_"
        f"height_alt+hip_amp_0.50+fy_bias_0+ffmpeg_all_intra;"
        f"DO_NOT_CLAIM_CONTROLS_PASS\n"
    )
    print(f"[dronable] log {log}")

    sys.exit(1 if (not assert_ok) or flipped or (exploded and data.time < 2.0) else 0)


if __name__ == "__main__":
    main()
