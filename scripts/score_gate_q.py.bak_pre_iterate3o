# Continuous-honesty escalate (iterate3n): dense multi-step throughout walk, not thin multi then slide.
# Thin multi (≥2/side or ≥3 total) kept for mid-settle trigger only.
SS_PER_SIDE_MIN = 2
SS_TOTAL_MIN = 3  # thin multi (mid-settle / criteria floor)
SS_DENSE_PER_SIDE = 3  # target ≥3–4 SS/side continuous-visible
SS_DENSE_TOTAL = 4  # ≥4 total with both ≥2 (2+2) or ≥3/side
GATE_Q_RES_POST_PROOF = "0.15"  # cut residual soft XY slide after dense proof
GATE_Q_SWING_XY_DAMP = "0.95"  # planted-feet freejoint XY damp per ctrl (anti soft-slide)
GATE_Q_PLANT_KD = "68"
