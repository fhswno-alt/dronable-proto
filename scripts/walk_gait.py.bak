#!/usr/bin/env python3
"""Dronable v0 — open-loop walking gait @ 50 Hz (Controls team params).

Gait: T=0.5 s, DS≈0.1 s, step 0.06 m, clearance 0.025 m,
hip pitch ±0.25 rad, knee stance 0.35 / swing peak 0.9 rad,
COM height ~0.22–0.24 m.

PD: kp 40/25/20, kd 1.0/0.6/0.4 (hips-knees / ankles / arms) via MuJoCo
position actuators + joint damping; torque clip stall×0.6.

Usage:
  python scripts/walk_gait.py                  # headless record 8 s MP4
  python scripts/walk_gait.py --view           # interactive viewer
  python scripts/walk_gait.py --duration 10 --out previews/walk.mp4
"""
from __future__ import annotations

import argparse
import math
import sys
from pathlib import Path

import mujoco as mj
import numpy as np

ROOT = Path(__file__).resolve().parents[1]
XML = ROOT / "mujoco" / "dronable_v0.xml"
PREVIEWS = ROOT / "previews"

# --- Controls team params (do not invent conflicting numbers) ---
CTRL_HZ = 50.0
GAIT_T = 0.5
DS_FRAC = 0.1 / GAIT_T  # double support ~0.1 s → fraction of cycle
STEP_LEN = 0.06
FOOT_CLEAR = 0.025
HIP_PITCH_AMP = 0.25
KNEE_STANCE = 0.35
KNEE_SWING = 0.90
COM_Z = 0.23  # mid of 0.22–0.24 m

# Teleop envelope (stub — wired for future Xbox)
TELEOP_RATE_LIMIT = 1.5  # rad/s
TELEOP_DEADBAND = 0.08
LEVER_Z = 0.275  # mid of 0.25–0.30 m

# Actuator name order must match MJCF
ACT_NAMES = [
    "m_waist_yaw", "m_head_yaw",
    "m_l_shoulder_pitch", "m_l_shoulder_roll", "m_l_elbow",
    "m_r_shoulder_pitch", "m_r_shoulder_roll", "m_r_elbow",
    "m_l_hip_yaw", "m_l_hip_roll", "m_l_hip_pitch", "m_l_knee",
    "m_l_ankle_pitch", "m_l_ankle_roll",
    "m_r_hip_yaw", "m_r_hip_roll", "m_r_hip_pitch", "m_r_knee",
    "m_r_ankle_pitch", "m_r_ankle_roll",
]


def clamp(x, lo, hi):
    return max(lo, min(hi, x))


def phase_leg(phi: float, side: str) -> float:
    """Return leg phase in [0,1); right lag by half cycle."""
    if side == "R":
        phi = (phi + 0.5) % 1.0
    return phi


def swing_blend(phi: float) -> float:
    """1 during swing, 0 during stance; DS at both ends of stance."""
    ds = DS_FRAC
    swing_start = 0.5 - ds * 0.25
    swing_end = 1.0 - ds * 0.25
    if swing_start <= phi < swing_end:
        w = (phi - swing_start) / (swing_end - swing_start)
        return math.sin(math.pi * w)  # 0→1→0 over swing
    return 0.0


def gait_targets(t: float, gait_on: bool, amp: float = 1.0) -> dict[str, float]:
    """Open-loop CPG / sine gait → desired joint positions (rad).

    amp in [0,1] ramps the walk so startup does not tip the floating base.
    Uses Controls T/step/clearance/hip/knee numbers; Y-forward sagittal = hip_pitch.
    """
    q = {
        "waist_yaw": 0.0,
        "head_yaw": 0.0,
        "l_shoulder_pitch": 0.12,
        "l_shoulder_roll": 0.30,
        "l_elbow": 0.45,
        "r_shoulder_pitch": 0.12,
        "r_shoulder_roll": -0.30,
        "r_elbow": 0.45,
        "l_hip_yaw": 0.0,
        "l_hip_roll": 0.06,
        "l_hip_pitch": -0.12,
        "l_knee": KNEE_STANCE,
        "l_ankle_pitch": -0.20,
        "l_ankle_roll": -0.04,
        "r_hip_yaw": 0.0,
        "r_hip_roll": -0.06,
        "r_hip_pitch": -0.12,
        "r_knee": KNEE_STANCE,
        "r_ankle_pitch": -0.20,
        "r_ankle_roll": 0.04,
    }
    if not gait_on or amp <= 0.0:
        return q

    a = clamp(amp, 0.0, 1.0)
    phi = (t / GAIT_T) % 1.0
    hip_bias = -0.08
    for side, prefix in (("L", "l_"), ("R", "r_")):
        p = phase_leg(phi, side)
        sw = swing_blend(p) * a
        # Sagittal hip about +X (Y-forward): negate cos → heel-strike foot forward (+Y)
        hip_osc = HIP_PITCH_AMP * a * math.cos(2 * math.pi * p)  # +cos → step toward +Y
        q[f"{prefix}hip_pitch"] = hip_bias + hip_osc

        q[f"{prefix}knee"] = KNEE_STANCE + (KNEE_SWING - KNEE_STANCE) * sw

        q[f"{prefix}ankle_pitch"] = -0.18 + 0.35 * sw - 0.10 * a * math.sin(2 * math.pi * p)

        roll_sign = 1.0 if side == "L" else -1.0
        q[f"{prefix}hip_roll"] = roll_sign * (0.06 + 0.08 * sw)

        arm = -0.35 * hip_osc
        q[f"{prefix}shoulder_pitch"] = 0.12 + arm
        q[f"{prefix}elbow"] = 0.40 + 0.15 * abs(arm)

    q["waist_yaw"] = 0.08 * a * math.sin(2 * math.pi * phi)
    return q


def apply_teleop_delta(
    q: dict[str, float],
    deltas: dict[str, float],
    dt: float,
    last_hold: dict[str, float] | None,
    soft_stop: bool,
) -> dict[str, float]:
    """Xbox → joint Δq with rate limit 1.5 rad/s, deadband 0.08; soft stop holds last q."""
    if soft_stop and last_hold is not None:
        return dict(last_hold)
    out = dict(q)
    max_step = TELEOP_RATE_LIMIT * dt
    for k, dq in deltas.items():
        if abs(dq) < TELEOP_DEADBAND:
            continue
        if k in out:
            out[k] = out[k] + clamp(dq, -max_step, max_step)
    return out


def _project_yaw_only(qpos: np.ndarray, qvel: np.ndarray, blend: float = 1.0) -> None:
    """Keep freejoint yaw, kill pitch/roll (v0 visual assist — not real balance)."""
    qw, qx, qy, qz = [float(v) for v in qpos[3:7]]
    # Yaw-only quaternion: drop qx,qy and renormalize (qw,qz)
    n = math.hypot(qw, qz)
    if n < 1e-8:
        tgt = np.array([1.0, 0.0, 0.0, 0.0])
    else:
        tgt = np.array([qw / n, 0.0, 0.0, qz / n])
    cur = np.array([qw, qx, qy, qz])
    # Match hemisphere
    if np.dot(cur, tgt) < 0:
        tgt = -tgt
    out = cur + blend * (tgt - cur)
    out = out / (np.linalg.norm(out) + 1e-12)
    qpos[3:7] = out
    # Kill pitch/roll rates (world x/y); keep yaw rate
    qvel[3] *= (1.0 - blend)
    qvel[4] *= (1.0 - blend)


def v0_balance_assist(model: mj.MjModel, data: mj.MjData, z_des: float = COM_Z):
    """Temporary upright/height assist for v0 visual gait (NOT production balance).

    Root cause of the broken preview: the prior bx/by PD let the floating base
    pitch-flip ~180° during gait onset (lean-into-pillar frame, then a hard cut
    into a post-flip mid-stride that looked frozen). This assist:
      1) applies gravity FF + height/lateral PD on the freejoint force
      2) applies upright torque from (up × z_world)
      3) softly projects orientation to yaw-only so pitch cannot run away

    Writes freejoint qfrc_applied (+ light qpos/qvel projection). Does NOT
    overwrite data.ctrl — legs still track the CPG.
    """
    bid = mj.mj_name2id(model, mj.mjtObj.mjOBJ_BODY, "pelvis")
    R = data.xmat[bid].reshape(3, 3)
    up = R[:, 2]
    axis = np.cross(up, np.array([0.0, 0.0, 1.0]))
    lean = float(np.linalg.norm(axis))
    if lean > 0.4:
        axis = axis * (0.4 / lean)

    omega = data.qvel[3:6]
    kp_ori, kd_ori = 100.0, 12.0
    torque = np.clip(kp_ori * axis - kd_ori * omega, -30.0, 30.0)

    mass = mj.mj_getTotalmass(model)
    z = data.qpos[2]
    fz = 0.80 * mass * 9.81 + 150.0 * (z_des - z) - 25.0 * data.qvel[2]
    fz = float(np.clip(fz, -50.0, 80.0))
    fx = float(np.clip(-15.0 * data.qpos[0] - 4.0 * data.qvel[0], -20.0, 20.0))
    fy = float(np.clip(-1.5 * data.qvel[1], -10.0, 10.0))
    data.qfrc_applied[0:6] = [fx, fy, fz, torque[0], torque[1], torque[2]]

    # Soft upright projection every assist call (physics step). Stronger when
    # already leaning so a tip cannot go over-centre.
    blend = 0.08 if up[2] > 0.9 else (0.25 if up[2] > 0.5 else 0.6)
    _project_yaw_only(data.qpos, data.qvel, blend=blend)


def set_ctrl(model: mj.MjModel, data: mj.MjData, qdes: dict[str, float], act_idx: dict[str, int]):
    for jname, val in qdes.items():
        aname = "m_" + jname
        if aname in act_idx:
            data.ctrl[act_idx[aname]] = val


def _write_video(path: Path, frames: list[np.ndarray], fps: float) -> None:
    """Write MP4 via imageio with explicit fps (libx264 when available)."""
    import imageio.v2 as imageio

    path.parent.mkdir(parents=True, exist_ok=True)
    # Ensure contiguous uint8 copies (avoid writer aliasing one buffer)
    safe = [np.ascontiguousarray(f, dtype=np.uint8) for f in frames]
    try:
        writer = imageio.get_writer(
            path,
            fps=fps,
            codec="libx264",
            quality=8,
            pixelformat="yuv420p",
            macro_block_size=1,
        )
        for f in safe:
            writer.append_data(f)
        writer.close()
    except Exception as e:
        print(f"[dronable] imageio writer fallback ({e})")
        imageio.mimsave(path, safe, fps=fps)


def main():
    ap = argparse.ArgumentParser(description="Dronable v0 walking gait (Controls 50 Hz PD)")
    ap.add_argument("--view", action="store_true", help="Interactive MuJoCo viewer")
    ap.add_argument("--duration", type=float, default=8.0, help="Sim duration seconds")
    ap.add_argument("--out", type=str, default=str(PREVIEWS / "walk_gait.mp4"))
    ap.add_argument("--gait-off", action="store_true", help="Hold stand pose (gait off)")
    ap.add_argument("--no-video", action="store_true")
    args = ap.parse_args()

    if not XML.exists():
        print(f"ERROR: missing {XML}", file=sys.stderr)
        sys.exit(1)

    model = mj.MjModel.from_xml_path(str(XML))
    data = mj.MjData(model)
    act_idx = {mj.mj_id2name(model, mj.mjtObj.mjOBJ_ACTUATOR, i): i for i in range(model.nu)}

    # Keyframe stand
    if model.nkey > 0:
        mj.mj_resetDataKeyframe(model, data, 0)
    else:
        data.qpos[2] = COM_Z
        data.qpos[3:7] = [1, 0, 0, 0]
    mj.mj_forward(model, data)

    ctrl_dt = 1.0 / CTRL_HZ
    sim_dt = model.opt.timestep
    steps_per_ctrl = max(1, int(round(ctrl_dt / sim_dt)))

    gait_on = not args.gait_off
    soft_stop = False
    last_hold: dict[str, float] | None = None
    teleop_deltas: dict[str, float] = {}
    # Hold stand, then ramp — avoids tip/flip during abrupt CPG onset
    stand_hold = 0.4
    ramp_t = 1.0

    def gait_amp(t: float) -> float:
        if not gait_on:
            return 0.0
        if t < stand_hold:
            return 0.0
        u = t - stand_hold
        if u >= ramp_t:
            return 1.0
        # Smoothstep ramp
        s = u / ramp_t
        return s * s * (3.0 - 2.0 * s)

    def _qadr(name: str) -> int:
        return int(model.jnt_qposadr[mj.mj_name2id(model, mj.mjtObj.mjOBJ_JOINT, name)])

    hip_l_adr = _qadr("l_hip_pitch")
    hip_r_adr = _qadr("r_hip_pitch")
    bid_l_ankle = mj.mj_name2id(model, mj.mjtObj.mjOBJ_BODY, "l_ankle")
    bid_r_ankle = mj.mj_name2id(model, mj.mjtObj.mjOBJ_BODY, "r_ankle")
    bid_pelvis = mj.mj_name2id(model, mj.mjtObj.mjOBJ_BODY, "pelvis")
    hip_l_hist: list[float] = []
    hip_r_hist: list[float] = []
    foot_l_z: list[float] = []
    foot_r_z: list[float] = []
    up_z_hist: list[float] = []

    print(f"[dronable] model={XML.name} nq={model.nq} nu={model.nu} dt={sim_dt}")
    print(f"[dronable] Controls: {CTRL_HZ} Hz PD gait T={GAIT_T}s step={STEP_LEN}m clear={FOOT_CLEAR}m")
    print(f"[dronable] COM target z≈{COM_Z}m lever≈{LEVER_Z}m gait_on={gait_on}")
    print(f"[dronable] mass≈{mj.mj_getTotalmass(model):.3f} kg")
    print(f"[dronable] stand_hold={stand_hold}s ramp={ramp_t}s (smoothstep)")

    if args.view:
        import time
        try:
            from mujoco import viewer
        except ImportError:
            print("viewer unavailable", file=sys.stderr)
            sys.exit(1)
        with viewer.launch_passive(model, data) as v:
            wall0 = time.time()
            while v.is_running() and (time.time() - wall0) < args.duration:
                t = data.time
                qdes = gait_targets(t, gait_on, gait_amp(t))
                qdes = apply_teleop_delta(qdes, teleop_deltas, ctrl_dt, last_hold, soft_stop)
                last_hold = dict(qdes)
                set_ctrl(model, data, qdes, act_idx)
                for _ in range(steps_per_ctrl):
                    v0_balance_assist(model, data, COM_Z)
                    mj.mj_step(model, data)
                    data.qfrc_applied[:] = 0
                v.sync()
                target = wall0 + data.time
                sleep = target - time.time()
                if sleep > 0:
                    time.sleep(sleep)
            print(f"[dronable] viewer done t={data.time:.2f}s pelvis_z={data.qpos[2]:.3f}")
            return

    # Headless + video — oblique view so orange/green feet don't overlap
    frames: list[np.ndarray] = []
    renderer = None
    cam = mj.MjvCamera()
    mj.mjv_defaultCamera(cam)
    cam.azimuth = 65.0
    cam.elevation = -18.0
    cam.distance = 1.05
    cam.lookat[:] = [0.0, 0.10, 0.14]
    cam_look_y0 = 0.10  # slow follow bias toward +Y walk

    debug_dir = PREVIEWS / "debug_frames"
    debug_dir.mkdir(parents=True, exist_ok=True)
    for old in debug_dir.glob("*.png"):
        old.unlink()
    strip_times = {0, 1, 2, 3, 4, 5, 6, 7}
    strip_saved: set[int] = set()
    debug_every = 10  # every 10 ctrl steps = 0.2 s @ 50 Hz
    pixel_mads: list[float] = []
    prev_frame: np.ndarray | None = None

    if not args.no_video:
        renderer = mj.Renderer(model, height=480, width=640)

    n_ctrl = int(args.duration * CTRL_HZ)
    exploded = False
    flipped = False
    import imageio.v2 as imageio

    # Capture true stand keyframe as first video frame + strip_t00 (no lean artifact)
    if renderer is not None:
        mj.mj_forward(model, data)
        cam.lookat[0] = float(data.qpos[0])
        cam.lookat[1] = float(data.qpos[1]) + 0.05
        cam.lookat[2] = 0.14
        renderer.update_scene(data, cam)
        img0 = np.ascontiguousarray(renderer.render().copy(), dtype=np.uint8)
        frames.append(img0)
        prev_frame = img0
        imageio.imwrite(debug_dir / "strip_t00.png", img0)
        imageio.imwrite(debug_dir / "frame_k0000_t00.00.png", img0)
        strip_saved.add(0)

    for k in range(n_ctrl):
        t = data.time
        qdes = gait_targets(t, gait_on, gait_amp(t))
        qdes = apply_teleop_delta(qdes, teleop_deltas, ctrl_dt, last_hold, soft_stop)
        last_hold = dict(qdes)
        set_ctrl(model, data, qdes, act_idx)
        for _ in range(steps_per_ctrl):
            v0_balance_assist(model, data, COM_Z)
            mj.mj_step(model, data)
            data.qfrc_applied[:] = 0
            if not np.isfinite(data.qpos).all() or data.qpos[2] < 0.05 or data.qpos[2] > 1.0:
                exploded = True
                break
        if exploded:
            print(f"[dronable] STOP early at t={data.time:.3f}s (fall/nan) z={data.qpos[2]}")
            break

        up_z = float(data.xmat[bid_pelvis].reshape(3, 3)[2, 2])
        up_z_hist.append(up_z)
        if up_z < 0.3:
            flipped = True

        hip_l_hist.append(float(data.qpos[hip_l_adr]))
        hip_r_hist.append(float(data.qpos[hip_r_adr]))
        foot_l_z.append(float(data.xpos[bid_l_ankle, 2]))
        foot_r_z.append(float(data.xpos[bid_r_ankle, 2]))

        # Render every ctrl step at 25 fps (drop every other)
        if renderer is not None and (k % 2 == 0):
            # Slow-follow: mostly fixed so foot swings read as image motion;
            # ease lookat toward pelvis so robot stays framed over 8 s.
            cam.lookat[0] = 0.7 * cam.lookat[0] + 0.3 * float(data.qpos[0])
            cam.lookat[1] = 0.7 * cam.lookat[1] + 0.3 * (float(data.qpos[1]) + 0.05)
            cam.lookat[2] = 0.14
            mj.mj_forward(model, data)  # ensure xpos/xmat current for render
            renderer.update_scene(data, cam)
            img = np.ascontiguousarray(renderer.render().copy(), dtype=np.uint8)
            if prev_frame is not None:
                mad = float(np.mean(np.abs(img.astype(np.float32) - prev_frame.astype(np.float32))))
                pixel_mads.append(mad)
            prev_frame = img
            frames.append(img)

            # Debug PNGs every 0.2 s of sim
            if k % debug_every == 0:
                imageio.imwrite(debug_dir / f"frame_k{k:04d}_t{t:05.2f}.png", img)

            # Timestamped strip at integer seconds (user-requested)
            t_round = int(round(t))
            if t_round in strip_times and t_round not in strip_saved and abs(t - t_round) < (ctrl_dt + 1e-6):
                imageio.imwrite(debug_dir / f"strip_t{t_round:02d}.png", img)
                strip_saved.add(t_round)
            # Mid-phase proof (T=0.5 → integer seconds share phase 0; also save +.25s)
            for t_ph, tag in ((int(t) + 0.25, "p25"), (int(t) + 0.125, "p125")):
                if 2 <= t_ph <= 7 and abs(t - t_ph) < (ctrl_dt + 1e-6):
                    imageio.imwrite(debug_dir / f"strip_t{int(t_ph):02d}_{tag}.png", img)

    z_final = float(data.qpos[2])
    hip_l_arr = np.asarray(hip_l_hist) if hip_l_hist else np.zeros(1)
    hip_r_arr = np.asarray(hip_r_hist) if hip_r_hist else np.zeros(1)
    fl_arr = np.asarray(foot_l_z) if foot_l_z else np.zeros(1)
    fr_arr = np.asarray(foot_r_z) if foot_r_z else np.zeros(1)
    up_arr = np.asarray(up_z_hist) if up_z_hist else np.zeros(1)
    # Steady-state window (after stand+ramp)
    i0 = int((stand_hold + ramp_t + 0.5) * CTRL_HZ)

    def _exc(a: np.ndarray) -> float:
        return float(np.ptp(a[i0:])) if len(a) > i0 else float(np.ptp(a))

    hip_exc = max(_exc(hip_l_arr), _exc(hip_r_arr))
    foot_lift = max(_exc(fl_arr), _exc(fr_arr))
    max_abs_hip = float(
        max(
            np.max(np.abs(hip_l_arr[i0:])) if len(hip_l_arr) > i0 else 0.0,
            np.max(np.abs(hip_r_arr[i0:])) if len(hip_r_arr) > i0 else 0.0,
        )
    )
    min_up = float(np.min(up_arr)) if len(up_arr) else 0.0

    mad_arr = np.asarray(pixel_mads) if pixel_mads else np.zeros(1)
    mad_mean = float(np.mean(mad_arr))
    mad_med = float(np.median(mad_arr))
    mad_max = float(np.max(mad_arr))
    # Per-second mean MAD from consecutive 25 fps frames
    mad_by_sec = []
    for s in range(int(args.duration)):
        # frames appended every 2 ctrl → 25 fps; MAD list aligns to those
        lo = s * 25
        hi = min((s + 1) * 25, len(mad_arr))
        if hi > lo:
            mad_by_sec.append((s, float(np.mean(mad_arr[lo:hi]))))

    print(f"[dronable] done t={data.time:.3f}s steps={n_ctrl} pelvis_z={z_final:.3f} "
          f"exploded={exploded} flipped={flipped} min_up_z={min_up:.3f}")
    print(f"[dronable] metrics: max_|hip_pitch|={max_abs_hip:.4f} rad  "
          f"hip_pitch_excursion={hip_exc:.4f} rad  foot_lift={foot_lift:.4f} m")
    print(f"[dronable] pixel_MAD consecutive(25fps): mean={mad_mean:.3f} median={mad_med:.3f} "
          f"max={mad_max:.3f} n={len(pixel_mads)}")
    for s, m in mad_by_sec:
        print(f"[dronable]   pixel_MAD t={s}-{s+1}s mean={m:.3f}")

    if renderer is not None and frames:
        out = Path(args.out)
        _write_video(out, frames, fps=25.0)
        print(f"[dronable] wrote {out} ({len(frames)} frames @25fps)")
        gif = out.with_suffix(".gif")
        # GIF at 12.5 fps from every other video frame
        imageio.mimsave(gif, frames[::2], fps=12.5)
        print(f"[dronable] wrote {gif} ({len(frames[::2])} frames @12.5fps)")

        # Ensure strip exists even if timing missed exact integers
        for ts in sorted(strip_times):
            dest = debug_dir / f"strip_t{ts:02d}.png"
            if not dest.exists():
                # +1 accounts for pre-loop stand frame
                idx = min(1 + int(ts * 25), len(frames) - 1)
                imageio.imwrite(dest, frames[idx])
                print(f"[dronable] strip backfill t={ts}s from frame {idx}")
        print(f"[dronable] debug PNGs → {debug_dir} "
              f"(every {debug_every} ctrl + strip_t00..t07)")

    if renderer is not None:
        renderer.close()

    log = PREVIEWS / "sim_run_log.txt"
    log.write_text(
        f"t_final={data.time:.4f}\n"
        f"pelvis_z={z_final:.4f}\n"
        f"exploded={exploded}\n"
        f"flipped={flipped}\n"
        f"min_up_z={min_up:.6f}\n"
        f"mass_kg={mj.mj_getTotalmass(model):.4f}\n"
        f"nu={model.nu}\n"
        f"ctrl_hz={CTRL_HZ}\n"
        f"gait_T={GAIT_T}\n"
        f"max_abs_hip_pitch_rad={max_abs_hip:.6f}\n"
        f"hip_pitch_excursion_rad={hip_exc:.6f}\n"
        f"foot_lift_m={foot_lift:.6f}\n"
        f"pixel_mad_mean={mad_mean:.6f}\n"
        f"pixel_mad_median={mad_med:.6f}\n"
        f"pixel_mad_max={mad_max:.6f}\n"
        f"n_video_frames={len(frames)}\n"
    )
    print(f"[dronable] log {log}")

    # Also write human-readable stdout capture file
    # (caller may tee; this mirrors key lines for the parent)
    sys.exit(1 if (exploded and data.time < 2.0) or flipped else 0)


if __name__ == "__main__":
    main()
